import cv2

# Load the pre-trained Haar cascade
watch_cascade = cv2.CascadeClassifier("watch_cascade.xml")

# Read the image
image = cv2.imread(r"C:\Users\bolla\Downloads\tree_image.jpg")

# Convert to grayscale
gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)

# Detect watches
watches = watch_cascade.detectMultiScale(
    gray,
    scaleFactor=1.1,
    minNeighbors=5,
    minSize=(30, 30)
)

# Draw rectangles
for (x, y, w, h) in watches:
    cv2.rectangle(image, (x, y), (x + w, y + h), (0, 255, 0), 2)

# Display the result
cv2.imshow("Detected Watch", image)
cv2.waitKey(0)
cv2.destroyAllWindows()
